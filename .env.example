# Copy to .env and adjust. Every value has a default; `docker compose up` works without a .env.

# --- LLM ---
# fake: rule-based stand-in, no key, no network. real: any OpenAI-compatible endpoint.
LLM_MODE=fake
# Required when LLM_MODE=real (no provider is assumed). Examples:
#   OpenRouter:   https://openrouter.ai/api/v1                 model e.g. openai/gpt-4o-mini
#   OpenAI:       https://api.openai.com/v1                    model e.g. gpt-4o-mini
#   Azure OpenAI: https://<resource>.openai.azure.com/openai/v1  model = your deployment name
#   Ollama:       http://host.docker.internal:11434/v1         model e.g. llama3.1, any non-empty key
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Fake mode only: share of LLM calls that fail with a temporary error (0..1).
LLM_FAKE_FAILURE_RATE=0.0

# --- Fake Helpdesk API ---
# Share of Helpdesk calls that fail with a temporary error (0..1).
HELPDESK_FAILURE_RATE=0.2

# --- Host ports published by docker compose ---
API_HOST_PORT=8000
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233

# --- Temporal ---
# For running the API / worker outside Docker; docker compose sets temporal:7233 itself.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=tickets
# How long the worker lets running activities finish after SIGTERM (keep below
# stop_grace_period of the worker in docker-compose.yml, 30 s).
WORKER_SHUTDOWN_GRACE_SECONDS=20

LOG_LEVEL=INFO
