# Copy to .env and adjust. Every value has a default; `docker compose up` works without a .env.

# --- LLM ---
# fake: rule-based stand-in, no key, no network. real: any OpenAI-compatible endpoint.
LLM_MODE=fake
# OpenRouter (default). Others: https://api.openai.com/v1,
# https://<resource>.openai.azure.com/openai/v1 (Azure OpenAI), http://host.docker.internal:11434/v1 (Ollama)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Fake mode only: share of LLM calls that fail with a temporary error (0..1).
LLM_FAKE_FAILURE_RATE=0.0

# --- Fake Helpdesk API ---
# Share of Helpdesk calls that fail with a temporary error (0..1).
HELPDESK_FAILURE_RATE=0.2

# --- Temporal ---
# docker compose overrides TEMPORAL_ADDRESS to temporal:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=tickets

LOG_LEVEL=INFO
